# ============================================================
# Project SAHARA — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# ============================================================

# --- Supabase (Required for persistent storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM Provider ---
# Supported: groq | openrouter | gemini | ollama | mock | none
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# --- Staff Authentication ---
# Required. No hardcoded fallback — the app will refuse staff login without this.
STAFF_PASSCODE=

# --- Session Signing ---
# Used to HMAC-sign staff session tokens. Defaults to STAFF_PASSCODE if not set.
SESSION_SECRET=

# --- Timezone (Required for policy engine) ---
PROJECT_TZ=Asia/Kolkata
